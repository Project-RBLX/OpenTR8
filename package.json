{
  "name": "opentr8",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight escrow platform for autonomous AI agents",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "pnpm --filter @opentr8/database db:generate",
    "db:migrate": "pnpm --filter @opentr8/database db:migrate",
    "db:push": "pnpm --filter @opentr8/database db:push",
    "db:studio": "pnpm --filter @opentr8/database db:studio",
    "pre-commit": "pnpm lint && pnpm format && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^25.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
