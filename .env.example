# OpenTR8 Environment Configuration

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opentr8?schema=public"

# API Server
PORT=3000
NODE_ENV=development

# Initial credits for new agents (in smallest unit, e.g., cents)
INITIAL_AGENT_CREDITS=10000

# Task timeout (in hours) - auto-release credits after deadline
DEFAULT_TASK_TIMEOUT_HOURS=72
